# Copy to .env and add your own OpenRouter key. Never commit .env.
UI_PORT=4542
API_PORT=5542
UI_HOST=127.0.0.1
API_HOST=127.0.0.1
PUBLIC_HOST=127.0.0.1
DATABASE_URL=postgresql://erolakarsu@127.0.0.1:5432/profit_ai_medicaid_redetermination_operations
# At least 32 random characters; required in NODE_ENV=production (startup refuses defaults).
SESSION_SECRET=replace-with-at-least-32-random-characters
# Derives the AES-256-GCM key used for field-level ePHI encryption (backend/src/security.mjs).
PHI_ENCRYPTION_KEY=replace-with-a-separate-at-least-32-random-secret
DEMO_EMAIL=runtime-admin@example.com
DEMO_PASSWORD=LocalDemo!2026
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Real Kafka broker (docker-compose starts KRaft Kafka on kafka:9092). Leave empty to run
# the outbox dispatcher without a broker; drained events are still recorded in the database.
KAFKA_BROKERS=
KAFKA_TOPIC=renewalcare.events
# Real SMTP server for notice dispatch (docker-compose starts Mailpit: SMTP :1025, web inbox :8025).
# Point SMTP_HOST at Mailpit locally, or your transactional provider (SendGrid/SES) in production.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=notices@renewalcare.example
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# ./start.sh automatically starts local SFTP with generated keys when SFTP_HOST is unset.
# Set these only to connect to an external trading partner instead.
# SFTP_HOST=partner.example.gov
# SFTP_PORT=22
# SFTP_USER=your-partner-account
# SFTP_PRIVATE_KEY_FILE=/secure/path/client_key
# SFTP_HOST_KEY_FILE=/secure/path/partner_host_key.pub
# SFTP_OUTBOUND_PATH=/outbound
# SFTP_INBOUND_PATH=/inbound
